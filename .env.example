# Firebase Web SDK
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_FIREBASE_API_KEY=replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_me
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_me
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_me
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
NEXT_PUBLIC_FIREBASE_APP_ID=replace_me
# Public reCAPTCHA Enterprise site key. Leave empty until App Check is configured.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Optional browser fail-closed mode. Keep false during observe rollout.
NEXT_PUBLIC_APP_CHECK_FAIL_CLOSED=false

# Server-side Firebase Admin
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# API request protection
# Local/emulator: off + local. Production must use observe/enforce and a trusted proxy.
APP_CHECK_MODE=off
APP_CHECK_ALLOWED_APP_IDS=
RATE_LIMIT_MODE=off
# At least 32 random characters. In cloud, reference Secret Manager instead of plaintext.
RATE_LIMIT_HMAC_SECRET=
RATE_LIMIT_KEY_VERSION=v1
TRUSTED_PROXY_MODE=local

# Approval message contact
APPROVAL_CONTACT_PHONE=+55-13-99999-9999

# Optional: emulator wiring
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Enable transfers only after indexes and staging validation. Missing means false.
CONTAINER_TRANSFERS_ENABLED=false

# Check-in v2: OFF by default. No Excel credentials or URL are required.
CHECKIN_SYSTEM_RECORD_ENABLED=false
CHECKIN_INTEGRATION_MODE=off
# Pausa novas chegadas sem desligar fila, consulta ou exigência de vínculo.
# Só produz efeito quando a revisão com esta configuração recebe a requisição.
CHECKIN_INTAKE_PAUSED=false
# Only enable enforce after isolated validation and operational approval.
CHECKIN_ENFORCE_ROLLOUT_APPROVED=false
CHECKIN_INTEGRATION_KEY_ID=
CHECKIN_INTEGRATION_HMAC_SECRET=
CHECKIN_INDEX_HMAC_SECRET=
CHECKIN_GEOFENCE_CENTER_LAT=
CHECKIN_GEOFENCE_CENTER_LNG=
CHECKIN_GEOFENCE_RADIUS_METERS=20000

# Documentos: habilitar somente no ambiente validado, com bucket privado e origem explícita.
CHECKIN_DOCUMENTS_ENABLED=false
CHECKIN_DOCUMENT_BUCKET=
CHECKIN_PORTAL_ORIGIN=
# Origem HTTPS exata da fila interna; não reutilizar a origem do portal.
# Em staging, também deve constar no CORS PUT do bucket privado.
CHECKIN_DOCUMENT_INTERNAL_ORIGIN=
