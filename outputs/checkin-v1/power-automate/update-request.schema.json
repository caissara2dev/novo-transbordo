{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "idempotencyKey",
    "identifier",
    "requestedAtIso",
    "payloadHash",
    "patch"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["checkin-excel.v1"]
    },
    "operation": {
      "type": "string",
      "enum": ["UPDATE"]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 14,
      "maxLength": 32
    },
    "identifier": {
      "type": "string",
      "minLength": 11,
      "maxLength": 11
    },
    "requestedAtIso": {
      "type": "string",
      "format": "date-time"
    },
    "payloadHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driverName": { "type": "string", "minLength": 1, "maxLength": 121 },
        "driverLicense": { "type": "string", "minLength": 11, "maxLength": 11 },
        "driverPhone": { "type": "string", "minLength": 11, "maxLength": 11 },
        "plate": { "type": "string", "minLength": 7, "maxLength": 7 },
        "carrierName": { "type": "string", "minLength": 1, "maxLength": 121 },
        "vehicleType": {
          "type": "string",
          "enum": ["Bitrem", "Rodotrem", "Vanderleia"]
        },
        "product": { "type": "string", "minLength": 1, "maxLength": 121 },
        "originPlant": { "type": "string", "minLength": 1, "maxLength": 121 },
        "originInvoiceNumbers": { "type": "string", "minLength": 1, "maxLength": 251 },
        "remittanceInvoiceNumber": { "type": "string", "minLength": 1, "maxLength": 251 },
        "whatsappNoticeAccepted": { "type": "string", "enum": ["Ciente"] },
        "queueLocationAccepted": { "type": "string", "enum": ["Ciente"] }
      }
    }
  }
}
