{
  "name": "controle-transbordo",
  "version": "2.5.1",
  "private": true,
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "firebase emulators:exec --config firebase.documents-test.json --project demo-checkin-nf --only firestore \"node scripts/run-checkin-coverage.mjs\"",
    "test:integration": "vitest run tests/integration",
    "test:rules": "firebase emulators:exec --project demo-transbordo --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test --pass-with-no-tests",
    "audit:all": "npm audit --audit-level=critical",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify:firestore-indexes": "node scripts/verify-firestore-indexes.mjs",
    "verify:server-bundle": "node scripts/verify-server-bundle.mjs",
    "verify": "npm run lint && npm run typecheck && npm run verify:firestore-indexes && npm run test:coverage && npm run test:rules && npm run test:e2e && npm run build && npm run verify:server-bundle && npm run audit:all && npm run audit:prod",
    "copy:staging": "node scripts/copy-staging-data.mjs",
    "backfill:container-states": "node --experimental-strip-types scripts/backfill-container-states.mjs",
    "promote-admin": "node scripts/promote-admin.mjs",
    "prototype": "vite --config prototype/vite.config.mts",
    "build:prototype": "vite build --config prototype/vite.config.mts",
    "test:prototype": "playwright test --config prototype/playwright.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.17.0",
    "firebase-admin": "14.4.0",
    "luxon": "^3.5.0",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "firebase-tools": "15.31.0",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "8.1.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "glob": {
      "minimatch": "9.0.8"
    },
    "next": {
      "postcss": "$postcss",
      "sharp": "0.35.4"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
